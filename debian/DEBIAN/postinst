#!/bin/bash
set -ex
mkdir -p /var/lib/nebius-observability-agent-updater
chmod 0640 /etc/nebius-observability-agent-updater/config.yaml

# A systemd reload makes Docker containers that got their GPUs from the NVIDIA
# runtime hook lose them ("Failed to initialize NVML: Unknown Error"), so these
# scripts never reload systemd. Each upgrade installs the unit file with a new
# mtime, so restart warns that it changed on disk and asks for daemon-reload;
# that warning is expected. A changed unit applies after the next reload or reboot.
# https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/troubleshooting.html#containers-losing-access-to-gpus-with-error-failed-to-initialize-nvml-unknown-error
systemctl --no-reload enable nebius_observability_agent_updater.service
if [ "$(systemctl is-system-running)" != "offline" ]; then # Check if running under systemd
  systemctl restart nebius_observability_agent_updater.service
fi
