#!/bin/bash
set -ex
mkdir -p /var/lib/nebius-observability-agent-updater
chmod 0640 /etc/nebius-observability-agent-updater/config.yaml

# The updater upgrades this package on VMs with running workloads. A systemd
# reload makes Docker containers lose GPU access ("Failed to initialize NVML:
# Unknown Error") when the NVIDIA runtime hook gave them the GPUs and systemd
# manages their cgroups. So the maintainer scripts never reload systemd: enable
# and disable run with --no-reload, and there is no daemon-reload. A changed
# unit file therefore applies only after the next systemd reload or VM reboot.
# NVIDIA: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/troubleshooting.html#containers-losing-access-to-gpus-with-error-failed-to-initialize-nvml-unknown-error
systemctl --no-reload enable nebius_observability_agent_updater.service
if [ "$(systemctl is-system-running)" != "offline" ]; then # Check if running under systemd
  systemctl restart nebius_observability_agent_updater.service
fi
